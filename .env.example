# Local port exposed on the NAS or development machine.
APP_PORT=3000

# Where holdings.json and future local app data should live.
DATA_PATH=./data

# Market/news cache duration in milliseconds. Default: 15 minutes.
CACHE_TTL_MS=900000

# Timeout for Yahoo Finance, Stooq, and RSS requests. Default: 10 seconds.
UPSTREAM_TIMEOUT_MS=10000

# Session lifetime in milliseconds. Default: 14 days.
SESSION_TTL_MS=1209600000

# Maximum JSON API request body size. Budget workbook uploads use their own 20 MB limit.
MAX_JSON_BODY_BYTES=1048576

# Keep false unless the app is on a trusted local-only network. When true, the unauthenticated
# password reset screen can set a new password for a local account by username/email.
ALLOW_INSECURE_ACCOUNT_RECOVERY=false

# Set true when the app is served only over HTTPS or behind a TLS reverse proxy.
FORCE_SECURE_COOKIES=false

# Unraid commonly uses nobody:users as 99:100 for appdata writes.
PUID=99
PGID=100

# For docker-compose.yml local builds.
IMAGE_NAME=finance-dashboard:local

# For docker-compose.ghcr.yml, replace the local image above with this GitHub Container Registry image.
# IMAGE_NAME=ghcr.io/piskooooo/finance-dashboard:latest
